# ─────────────────────────────────────────────────────────────────────────────
# Copiá este archivo a .env y completá lo que uses.
#
#   cp .env.example .env
#
# El dashboard arranca igual con todo vacío: cada sección que le falte una
# credencial devuelve 503 con un mensaje que dice cuál, y el resto funciona.
# Al arrancar te lista exactamente qué falta.
#
# Cómo se saca cada valor: docs/setup.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Tu negocio ───────────────────────────────────────────────────────────────
# Aparecen en el título, el encabezado y el prompt del análisis con IA.
BUSINESS_NAME="Mi Tienda"
BUSINESS_TYPE="tiendas de e-commerce"
SITE_URL="https://mitienda.com"
APP_CONTACT_EMAIL="vos@mitienda.com"
CURRENCY="ARS"
LOCALE="es-AR"

# ── Meta Ads ─────────────────────────────────────────────────────────────────
# docs/setup.md#meta — usá un token de System User: no vence.
META_ACCESS_TOKEN=""

# Solo para renovar el token solo. Un System User Token no los necesita.
META_APP_ID=""
META_APP_SECRET=""

# ── Meta Conversions API ─────────────────────────────────────────────────────
# docs/setup.md#pixel — sin esto el webhook no manda nada y te avisa.
# El píxel del navegador tiene que mandar el id de la orden como eventID, o no
# hay deduplicación y cada compra se cuenta dos veces.
META_PIXEL_ID=""

# ── Tienda ───────────────────────────────────────────────────────────────────
# docs/setup.md#tienda — `npm run setup:tiendanube` hace el OAuth por vos.
STORE_PLATFORM="tiendanube"
TIENDANUBE_ACCESS_TOKEN=""
TIENDANUBE_STORE_ID=""

# El App ID solo hace falta para correr el OAuth.
TIENDANUBE_APP_ID=""

# El client secret hace DOS cosas: corre el OAuth y firma los webhooks.
# Sin él, el webhook acepta cualquier POST y alguien puede inyectarle a Meta
# una compra que nunca existió. Dejalo puesto. Ver docs/webhook.md#firma
TIENDANUBE_CLIENT_SECRET=""

# ── Análisis con IA (opcional) ───────────────────────────────────────────────
# docs/setup.md#ia — sin key, /api/analyze devuelve 503 y nada más se rompe.
AI_ENABLED="true"
OPENROUTER_API_KEY=""
# Verificado contra la lista de openrouter.ai/models. Si lo cambias, chequea
# que el id exista: uno inventado devuelve 502 y no se nota hasta que apretas
# el boton de analizar.
OPENROUTER_MODEL="anthropic/claude-haiku-4.5"

# ── Servidor ─────────────────────────────────────────────────────────────────
# Probarlo sin credenciales: datos sinteticos, deterministas, sin red.
# Es lo que se ve en la captura del README.
DEMO_MODE=""

PORT="3000"
HOST="127.0.0.1"

# Orígenes que pueden consumir la API desde otro sitio, separados por coma.
# Vacío = solo el mismo origen, que es lo que el dashboard necesita.
# NUNCA pongas "*": cualquier página que visites podría leer tus métricas.
ALLOWED_ORIGINS=""

# NO_OPEN=1 evita que abra una pestaña del navegador en cada arranque.
NO_OPEN=""

# ── Ajustes finos ────────────────────────────────────────────────────────────
CACHE_TTL_MINUTES="10"
ANALYTICS_CACHE_TTL_MINUTES="30"

# Inferir el género del comprador a partir del nombre de pila. Es una
# heurística sobre datos personales, depende del país y se equivoca.
# Apagada por defecto. Ver docs/configuracion.md#genero.
FEATURE_INFER_GENDER="false"

# Dónde viven los archivos de credenciales y los logs.
CREDENTIALS_DIR=""
LOG_DIR=""
